# Copia este archivo a .env y llena lo que ya tengan.
# No subas .env. Las CLABEs de prueba tampoco van aquí.

PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_BANK_ACCOUNT_ID=
PEY_MAX_AMOUNT=0.01
PEY_BASE_URL=https://api.pey.mx

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
OWNER_WHATSAPP=

# Solo si van a transcribir notas de voz o leer fotos de tickets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

HOST=127.0.0.1
PORT=8787
REGISTRO_PATH=data/registro.sqlite
LIMITES_PATH=data/limites.sqlite

# 0 pausa los cobros nuevos; los pagos en camino se siguen conciliando.
COBROS_ACTIVOS=
